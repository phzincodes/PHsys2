<UserControl x:Class="PHsystem.Desktop.Components.CategoryResults" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding}"><ItemsControl.ItemTemplate><DataTemplate>
  <Border Style="{DynamicResource Panel}" Margin="0,0,0,14"><StackPanel>
   <DockPanel><Border DockPanel.Dock="Right" Style="{DynamicResource StateBadge}"><TextBlock Text="{Binding State}" FontSize="11"/></Border><TextBlock Text="{Binding Name}" Style="{DynamicResource SectionTitle}"/></DockPanel>
   <TextBlock Text="{Binding Source}" Style="{DynamicResource Caption}" Margin="0,8,0,0"/>
   <TextBlock Text="{Binding ExpiresAt}" Style="{DynamicResource Caption}"/>
   <Expander Header="Ver informações" Margin="0,12,0,0"><StackPanel>
    <DataGrid ItemsSource="{Binding Facts}" MaxHeight="400" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="Informação" Binding="{Binding Name}" Width="1*"/><DataGridTextColumn Header="Valor coletado" Binding="{Binding Value}" Width="2*"/></DataGrid.Columns></DataGrid>
    <TextBlock Text="{Binding Errors}" Foreground="{DynamicResource WarningBrush}" Margin="0,8,0,0"/>
   </StackPanel></Expander>
  </StackPanel></Border>
 </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
</UserControl>
