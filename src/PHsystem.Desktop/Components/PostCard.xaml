<UserControl x:Class="PHsystem.Desktop.Components.PostCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PHsystem.Desktop.Components" xmlns:present="clr-namespace:PHsystem.Desktop">
 <UserControl.Resources><present:ReactionSummaryConverter x:Key="ReactionSummary"/><BooleanToVisibilityConverter x:Key="CardVisibility"/></UserControl.Resources>
 <Border Style="{DynamicResource Panel}" Padding="20,16" Margin="0,0,0,14">
  <StackPanel>
   <DockPanel><TextBlock Text="{Binding Category}" Foreground="{DynamicResource AccentBrush}" FontSize="11" DockPanel.Dock="Right"/><StackPanel Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource HoverBrush}" Margin="0,0,8,0"><local:IconControl Data="M12,3 A4,4 0 1 1 11.99,3 M4,21 V18 Q4,13 12,13 Q20,13 20,18 V21" Width="16" Height="16" Stroke="{DynamicResource SecondaryBrush}"/></Border><TextBlock Text="{Binding Author}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryBrush}"/><TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd/MM HH:mm}}" Style="{DynamicResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel></DockPanel>
   <Button Command="{Binding OpenCommand, RelativeSource={RelativeSource AncestorType=local:PostCard}}" CommandParameter="{Binding}" Style="{DynamicResource QuietButton}" HorizontalContentAlignment="Left" Padding="0,12,0,4"><TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" LineHeight="25" Foreground="{DynamicResource TextBrush}"/></Button>
   <TextBlock Text="Solução aceita pelo autor" Foreground="{DynamicResource AccentBrush}" FontSize="11" Visibility="{Binding Solved, Converter={StaticResource CardVisibility}}" Margin="0,6,0,4"/><TextBlock Text="{Binding Body}" Foreground="{DynamicResource SecondaryBrush}" MaxHeight="60" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,4,0,14"/>
   <DockPanel><TextBlock Text="{Binding ReplyCount, StringFormat={}{0} respostas}" DockPanel.Dock="Right" Style="{DynamicResource Caption}" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal">
     <Button Command="{Binding UpvoteCommand, RelativeSource={RelativeSource AncestorType=local:PostCard}}" CommandParameter="{Binding}" Style="{DynamicResource LikePostAction}" AutomationProperties.Name="Curtir publicação" ToolTipService.ShowOnDisabled="True"/>
     <TextBlock Text="{Binding Converter={StaticResource ReactionSummary}}" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" Margin="12,0"/>
     <Button Command="{Binding SaveCommand, RelativeSource={RelativeSource AncestorType=local:PostCard}}" CommandParameter="{Binding}" Style="{DynamicResource SavedPostAction}" Padding="10,4" Margin="12,0,0,0"></Button>
    </StackPanel>
   </DockPanel>
  </StackPanel>
 </Border>
</UserControl>
