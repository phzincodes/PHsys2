<Window x:Class="PHsystem.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:components="clr-namespace:PHsystem.Desktop.Components" xmlns:views="clr-namespace:PHsystem.Desktop.Views" Title="PHsystem Next" Width="1380" Height="880" MinWidth="640" MinHeight="360" Loaded="WindowLoaded" SizeChanged="WindowSizeChanged" SourceInitialized="WindowSourceInitialized" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="{DynamicResource BodyFontSize}" WindowStartupLocation="CenterScreen" components:Motion.Enabled="{Binding Preferences.AnimationsEnabled}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <CollectionViewSource x:Key="NavigationSource">
        <CollectionViewSource.GroupDescriptions>
          <PropertyGroupDescription PropertyName="Group" />
        </CollectionViewSource.GroupDescriptions>
      </CollectionViewSource>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Background="{DynamicResource BackgroundBrush}">
   <Grid x:Name="AppShell">
  <Grid.InputBindings>
    <KeyBinding Key="D1" Modifiers="Control" Command="{Binding OpenOverviewCommand}" />
    <KeyBinding Key="D2" Modifiers="Control" Command="{Binding OpenDiagnosticsCommand}" />
    <KeyBinding Key="D3" Modifiers="Control" Command="{Binding OpenCleanupCommand}" />
    <KeyBinding Key="F5" Command="{Binding ScanCommand}" />
  </Grid.InputBindings>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{Binding SidebarWidth}" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="88" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="16,18,12,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Border Width="32" Height="32" Background="{DynamicResource AccentMutedBrush}" CornerRadius="7" VerticalAlignment="Center">
            <Grid>
              <TextBlock Text="PH" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
              <Image Source="{Binding Logo}" Stretch="Uniform" />
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,0,0" Visibility="{Binding SidebarExpanded, Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="PHsystem" FontSize="17" FontWeight="SemiBold" LineHeight="23" />
            <TextBlock Text="NEXT · DESKTOP" Style="{DynamicResource Eyebrow}" FontSize="9" />
          </StackPanel>
        </Grid>
        <ListBox Style="{DynamicResource {x:Type ListBox}}" x:Name="MainNavigation" Grid.Row="1" ItemsSource="{Binding Source={StaticResource NavigationSource}}" SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}" ItemContainerStyle="{DynamicResource NavigationItem}" BorderThickness="0" Background="Transparent" Margin="8,0" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="MainNavigation" AutomationProperties.Name="Navegação principal">
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem"><StackPanel><ContentPresenter/><ItemsPresenter/></StackPanel></ControlTemplate></Setter.Value></Setter></Style></GroupStyle.ContainerStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" Style="{DynamicResource Eyebrow}" Margin="12,20,0,6" FontSize="9" Visibility="{Binding DataContext.SidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}" />
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListBox.GroupStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ToolTip="{Binding Title}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="52" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <components:IconControl Data="{Binding Icon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Width="22" Height="22" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Margin="0,0,12,0" FontSize="12" VerticalAlignment="Center" TextWrapping="NoWrap" Visibility="{Binding DataContext.SidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Margin="14,16,14,18">
          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
            <Button Command="{Binding ToggleSidebarCommand}" ToolTip="{Binding SidebarToggleLabel}" AutomationProperties.Name="{Binding SidebarToggleLabel}" Style="{DynamicResource QuietButton}" Padding="0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <components:IconControl Data="M4,6 H20 M4,12 H20 M4,18 H20" Stroke="{DynamicResource SecondaryBrush}" Width="20" Height="20"/>
                <TextBlock Grid.Column="1" Text="Recolher menu" Margin="8,0,0,0" FontSize="11" Visibility="{Binding SidebarExpanded, Converter={StaticResource BoolVisibility}}" />
              </Grid>
            </Button>
          </Border>
          <Button Content="{Binding AccountLabel}" Command="{Binding OpenAccountCommand}" Style="{DynamicResource QuietButton}" HorizontalAlignment="Left" Margin="0,6,0,0" AutomationProperties.Name="Conta da comunidade"/>
          <TextBlock Text="{Binding ApplicationVersion}" Style="{DynamicResource Caption}" FontSize="10" Margin="6,10,0,0" Visibility="{Binding SidebarExpanded, Converter={StaticResource BoolVisibility}}" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Margin="30,24,30,20">
        <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsHome}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
            <TextBlock Text="PHSYSTEM" Style="{DynamicResource Eyebrow}" />
            <TextBlock Text=" / " Foreground="{DynamicResource BorderBrush}" Margin="8,0" FontSize="10" />
            <TextBlock Text="{Binding PageGroup}" Style="{DynamicResource Eyebrow}" />
          </StackPanel>
          <TextBlock Text="{Binding PageTitle}" Style="{DynamicResource Title}" AutomationProperties.AutomationId="PageTitle" />
          <TextBlock Text="{Binding PageDescription}" Style="{DynamicResource Caption}" Margin="0,5,12,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
          <Button Content="Cancelar" Command="{Binding CancelCommand}" Style="{DynamicResource QuietButton}" Margin="0,0,10,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
          <Button Command="{Binding ExportCommand}" Margin="0,0,10,0" ToolTip="Exportar o diagnóstico atual para um arquivo privado">
            <StackPanel Orientation="Horizontal">
              <components:IconControl Data="M12,3 V15 M8,11 L12,15 16,11 M4,17 V21 H20 V17" Stroke="{DynamicResource SecondaryBrush}" Width="18" Height="18" Margin="0,0,9,0"/>
              <TextBlock Text="Exportar" />
            </StackPanel>
          </Button>
          <Button Command="{Binding ScanCommand}" Style="{DynamicResource PrimaryButton}" AutomationProperties.AutomationId="ScanButton" ToolTip="Uma análise local que alimenta todas as telas · F5">
            <StackPanel Orientation="Horizontal">
              <components:IconControl Data="M20,8 A8,8 0 1 0 20,16 M20,3 V8 H15" Stroke="White" Width="18" Height="18" Margin="0,0,9,0"/>
              <TextBlock Text="{Binding ScanButtonText}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
      <components:AccessiblePageHost x:Name="PageHost" Grid.Row="1" Style="{StaticResource PageHost}" SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}" Margin="30,0,22,22" AutomationProperties.Name="Área de trabalho">
        <TabItem Header="Visão geral">
          <views:OverviewView />
        </TabItem>
        <TabItem Header="Diagnóstico">
          <views:DiagnosticsView />
        </TabItem>
        <TabItem Header="Limpeza">
          <views:CleanupView />
        </TabItem>
        <TabItem Header="Armazenamento">
          <views:StorageView />
        </TabItem>
        <TabItem Header="Drivers">
          <views:DriversView />
        </TabItem>
        <TabItem Header="PH CORE">
          <views:RecommendationsView />
        </TabItem>
        <TabItem Header="Modo Jogo">
          <views:GameView />
        </TabItem>
        <TabItem Header="Histórico">
          <views:HistoryView />
        </TabItem>
        <TabItem Header="Comunidade">
          <views:CommunityShell />
        </TabItem>
        <TabItem Header="Privacidade">
          <views:PrivacyView />
        </TabItem>
        <TabItem Header="Hardware"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Placa-mãe e sensores: indisponíveis nos coletores atuais." Style="{DynamicResource Caption}" Margin="0,0,0,16"/><components:CategoryResults Grid.Row="1" DataContext="{Binding HardwareCategories}"/></Grid></TabItem>
        <TabItem Header="Segurança"><components:CategoryResults DataContext="{Binding SecurityCategories}"/></TabItem>
        <TabItem Header="Desempenho"><components:CategoryResults DataContext="{Binding PerformanceCategories}"/></TabItem>
        <TabItem Header="Configurações"><views:SettingsView/></TabItem>
      </components:AccessiblePageHost>
      <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource SidebarBrush}" Padding="26,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
            <Ellipse Width="5" Height="5" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0" />
            <TextBlock Text="{Binding OperationLabel}" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding Status}" ToolTip="{Binding Status}" FontSize="11" LineHeight="17" MaxHeight="34" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" AutomationProperties.AutomationId="OperationStatus" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Grid.Column="2" Text="Dados locais" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="20,0,0,0" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
   </Grid>
   <views:AuthenticationView x:Name="Authentication" Visibility="Collapsed"/>
  </Grid>
</Window>