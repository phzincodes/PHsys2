<UserControl x:Class="PHsystem.Desktop.Views.CommunityFeedView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PHsystem.Desktop" xmlns:views="clr-namespace:PHsystem.Desktop.Views" xmlns:components="clr-namespace:PHsystem.Desktop.Components" Loaded="FeedLoaded">
 <UserControl.Resources><local:ReviewLabelConverter x:Key="ReviewLabel"/><local:ReplyIndentConverter x:Key="ReplyIndent"/><local:NotificationLabelConverter x:Key="NotificationLabel"/><BooleanToVisibilityConverter x:Key="BoolVisibility"/></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,4,0,20"><Button Content="Criar publicação" Command="{Binding NewPostCommand}" DockPanel.Dock="Right" Style="{DynamicResource PrimaryButton}" Margin="18,0,0,0"/><TextBlock Text="PH / COMUNIDADE" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,24,0"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pesquisar publicações" ToolTip="Pesquisar título e conteúdo"/></DockPanel>
  <TabControl Grid.Row="1" SelectedIndex="{Binding FeedTabIndex, Mode=TwoWay}" IsEnabled="{Binding IsReady}">
   <TabItem Header="Feed"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
    <Grid Margin="0,0,18,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,14"><Button Content="Atualizar" Command="{Binding LoadFeedCommand}" DockPanel.Dock="Right" Margin="10,0,0,0"/><ComboBox ItemsSource="{Binding FeedSorts}" SelectedItem="{Binding SelectedFeedSort}" DisplayMemberPath="Label" AutomationProperties.Name="Ordenação do feed"/></DockPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel><WrapPanel Margin="0,0,0,14"><TextBlock Text="Tipo" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox ItemsSource="{Binding PostKinds}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding FeedKind}" MinWidth="150"/><CheckBox Content="Resolvidos" IsChecked="{Binding OnlySolved}" Margin="16,0,0,0"/><CheckBox Content="Sem resposta" IsChecked="{Binding OnlyUnanswered}" Margin="16,0,0,0"/></WrapPanel><TextBlock Text="{Binding FeedStatus}" Style="{DynamicResource Caption}" Margin="0,0,0,14"/><ItemsControl ItemsSource="{Binding Posts}"><ItemsControl.ItemTemplate><DataTemplate><components:PostCard UpvoteCommand="{Binding DataContext.UpvoteCommand, RelativeSource={RelativeSource AncestorType=views:CommunityFeedView}}" DownvoteCommand="{Binding DataContext.DownvoteCommand, RelativeSource={RelativeSource AncestorType=views:CommunityFeedView}}" SaveCommand="{Binding DataContext.ToggleSaveCommand, RelativeSource={RelativeSource AncestorType=views:CommunityFeedView}}" OpenCommand="{Binding DataContext.OpenPostCommand, RelativeSource={RelativeSource AncestorType=views:CommunityFeedView}}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
     <StackPanel Grid.Row="1" IsHitTestVisible="False" Visibility="{Binding IsFeedLoading, Converter={StaticResource BoolVisibility}}" VerticalAlignment="Top" Background="{DynamicResource BackgroundBrush}"><Border Height="14" Width="160" HorizontalAlignment="Left" Background="{DynamicResource HoverBrush}" CornerRadius="4" Margin="20,20,20,14"/><Border Height="22" Background="{DynamicResource HoverBrush}" CornerRadius="4" Margin="20,0,40,14"/><Border Height="70" Background="{DynamicResource PanelBrush}" CornerRadius="6" Margin="20,0,20,20"/><TextBlock Text="Carregando dados da API…" Style="{DynamicResource Caption}" Margin="20,0,0,20"/></StackPanel>
     <Button Grid.Row="2" Content="Carregar mais" Command="{Binding MoreFeedCommand}" IsEnabled="{Binding HasMore}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
    </Grid>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{DynamicResource Panel}" Padding="16"><StackPanel><TextBlock Text="Categorias" Style="{DynamicResource SectionTitle}" Margin="0,0,0,14"/><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding FeedCategory}" AutomationProperties.Name="Categoria do feed"/><Button Content="Filtrar" Command="{Binding LoadFeedCommand}" Margin="0,10,0,0"/><Button Content="Todas as categorias" Command="{Binding ClearCategoryCommand}" Style="{DynamicResource QuietButton}"/><Button Content="Seguir categoria" Command="{Binding FollowCategoryCommand}" Style="{DynamicResource QuietButton}" Margin="0,6,0,0"/><Button Content="Deixar de seguir" Command="{Binding UnfollowCategoryCommand}" Style="{DynamicResource QuietButton}"/><ItemsControl ItemsSource="{Binding FollowedCategories}"/></StackPanel></Border><Border Style="{DynamicResource Notice}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Ajude com evidências" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="Respeite a privacidade. Explique riscos. Votos não representam revisão técnica. Nunca execute comandos de posts sem avaliação." Style="{DynamicResource Caption}"/></StackPanel></Border></StackPanel></ScrollViewer>
   </Grid></TabItem>
   <TabItem Header="Publicação"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,4,12,12"><TextBlock Text="{Binding SelectedPost.Title}" Style="{DynamicResource Title}"/><TextBlock Text="{Binding SelectedPost.Author}" Style="{DynamicResource Caption}" Margin="0,8,0,0"/><TextBlock Text="{Binding SelectedPost.Body}" Margin="0,18,0,20"/><Button Command="{Binding FollowSelectedPostCommand}" HorizontalAlignment="Left" Margin="0,0,0,12"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Content" Value="Seguir publicação"/><Style.Triggers><DataTrigger Binding="{Binding SelectedPost.Followed}" Value="True"><Setter Property="Content" Value="Parar de seguir"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="Atualizar respostas" Command="{Binding LoadRepliesCommand}" HorizontalAlignment="Left"/><ListBox ItemsSource="{Binding Replies}" SelectedItem="{Binding SelectedReply}" MaxHeight="400" Margin="0,16,0,0"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="{Binding Depth, Converter={StaticResource ReplyIndent}}"><TextBlock Text="{Binding Author}" FontWeight="SemiBold"/><TextBlock Text="{Binding Body}" Margin="0,8,0,8"/><TextBlock Text="Solução aceita pelo autor" Foreground="{DynamicResource AccentBrush}" FontSize="11" Visibility="{Binding Accepted, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding ReviewState, Converter={StaticResource ReviewLabel}}" Foreground="{DynamicResource WarningBrush}" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Button Content="Aceitar solução selecionada" Command="{Binding AcceptSolutionCommand}" HorizontalAlignment="Left" Margin="0,12,0,18"/><WrapPanel Margin="0,0,0,10"><Button Content="Responder à selecionada" Command="{Binding ReplyToSelectedCommand}" Style="{DynamicResource QuietButton}"/><Button Content="Responder à pergunta" Command="{Binding ReplyToPostCommand}" Style="{DynamicResource QuietButton}"/></WrapPanel><TextBlock Text="{Binding ReplyContext}" Style="{DynamicResource FieldLabel}"/><TextBox Text="{Binding ReplyBody, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="100" MaxLength="8000" TextWrapping="Wrap"/><Button Content="Responder" Command="{Binding ReplyCommand}" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0"/><Expander Header="Denunciar"><StackPanel Margin="0,10,0,0"><TextBox Text="{Binding ReportReason, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000"/><Button Content="Enviar denúncia" Command="{Binding ReportCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Expander><Expander Header="Gerenciar minha publicação"><StackPanel Margin="0,10,0,0"><Button Content="Editar minha publicação" Command="{Binding EditSelectedCommand}" HorizontalAlignment="Left"/><CheckBox Content="Confirmo a remoção da minha publicação" IsChecked="{Binding DeletePostConsent}"/><Button Content="Remover publicação" Command="{Binding DeleteSelectedCommand}" Style="{DynamicResource DangerButton}" HorizontalAlignment="Left"/></StackPanel></Expander><Expander Header="Editar ou remover uma resposta sua"><StackPanel><Button Content="Editar resposta selecionada" Command="{Binding BeginReplyEditCommand}" IsEnabled="{Binding SelectedReply.IsOwner}" HorizontalAlignment="Left"/><TextBox Text="{Binding ReplyEditBody}" AcceptsReturn="True" MinHeight="100" MaxLength="8000" Margin="0,12"/><Button Content="Salvar edição" Command="{Binding SaveReplyEditCommand}" IsEnabled="{Binding SelectedReply.IsOwner}" HorizontalAlignment="Left"/><CheckBox Content="Confirmo a remoção da minha resposta selecionada" IsChecked="{Binding ReplyDeleteConsent}"/><Button Content="Remover resposta" Command="{Binding RemoveReplyCommand}" IsEnabled="{Binding SelectedReply.IsOwner}" Style="{DynamicResource DangerButton}" HorizontalAlignment="Left"/><TextBlock Text="Editar retira a revisão técnica e a solução aceita, quando aplicável. Versões anteriores ficam no histórico privado." Style="{DynamicResource Caption}" Margin="0,12,0,0"/></StackPanel></Expander></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Publicar"><ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{DynamicResource Panel}" MaxWidth="720" HorizontalAlignment="Left"><StackPanel><TextBlock Text="Uma boa pergunta começa com contexto" Style="{DynamicResource SectionTitle}"/><TextBlock Text="Diagnósticos nunca são anexados automaticamente. Não publique logs brutos ou dados pessoais." Style="{DynamicResource Caption}" Margin="0,8,0,20"/><TextBlock Text="Título" Style="{DynamicResource FieldLabel}"/><TextBox Text="{Binding PostTitle, UpdateSourceTrigger=PropertyChanged}" MaxLength="160"/><TextBlock Text="Tipo de publicação" Style="{DynamicResource FieldLabel}" Margin="0,16,0,6"/><ComboBox ItemsSource="{Binding PostKinds}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding PostKind}"/><TextBlock Text="Categoria" Style="{DynamicResource FieldLabel}" Margin="0,16,0,6"/><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding PostCategory}"/><TextBlock Text="Descrição" Style="{DynamicResource FieldLabel}" Margin="0,16,0,6"/><TextBox Text="{Binding PostBody, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180" MaxLength="8000"/><WrapPanel Margin="0,14"><Button Content="Salvar rascunho local" Command="{Binding SaveDraftCommand}"/><Button Content="Restaurar meu rascunho" Command="{Binding LoadDraftCommand}" Margin="8,0"/><Button Content="Pré-visualizar texto" Command="{Binding PreviewPostCommand}"/></WrapPanel><Expander Header="Prévia segura"><TextBlock Text="{Binding PostPreview}"/></Expander><Button Content="Publicar ou salvar edição" Command="{Binding SavePostCommand}" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border></ScrollViewer></TabItem>
   <TabItem Header="Perfis"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="700" HorizontalAlignment="Left"><DockPanel><Button Content="Ver perfil público" Command="{Binding LoadProfileCommand}" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" MinWidth="260" AutomationProperties.Name="Nome para consultar perfil público"/></DockPanel><Border Style="{DynamicResource Panel}" Margin="0,18,0,0"><StackPanel><TextBlock Text="{Binding Profile.Username}" Style="{DynamicResource Title}"/><TextBlock Text="{Binding Profile.Bio}" Margin="0,12,0,16"/><TextBlock Text="{Binding Profile.Posts, StringFormat={}Publicações: {0}}"/><TextBlock Text="{Binding Profile.Replies, StringFormat={}Respostas: {0}}"/><TextBlock Text="{Binding Profile.AcceptedSolutions, StringFormat={}Soluções aceitas: {0}}"/><ItemsControl ItemsSource="{Binding Profile.Hardware}" Margin="0,14,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Key}" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,12,0"/><TextBlock Text="{Binding Value}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Expander Header="Editar minha descrição pública"><StackPanel Margin="0,12,0,0"><TextBox Text="{Binding ProfileBio, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" AcceptsReturn="True" MinHeight="80"/><Button Content="Salvar descrição" Command="{Binding SaveProfileCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Expander><Border Style="{DynamicResource Panel}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Visibilidade e saúde opcional" Style="{DynamicResource SectionTitle}"/><Button Content="Carregar minhas preferências" Command="{Binding LoadOwnProfileSettingsCommand}" HorizontalAlignment="Left" Margin="0,12"/><CheckBox Content="Permitir visitantes verem meu perfil e o hardware que compartilhei" IsChecked="{Binding PublicProfileEnabled}"/><TextBlock Text="Cor de destaque (#RRGGBB)"/><TextBox Text="{Binding ProfileAccent}"/><Button Content="Salvar visibilidade" Command="{Binding SavePublicSettingsCommand}" HorizontalAlignment="Left" Margin="0,12"/><Button Content="Ver como visitante" Command="{Binding PreviewVisitorProfileCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding Profile.Reputation, StringFormat={}Reputação por contribuições: {0}}" Margin="0,14,0,0"/><TextBlock Text="{Binding ProfileHealthLabel}" Margin="0,8"/><ComboBox ItemsSource="{Binding HealthSharingModes}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding HealthSharingMode}"/><CheckBox Content="Participar do ranking autodeclarado (somente nota completa)" IsChecked="{Binding HealthRankingConsent}"/><Button Content="Confirmar preferência de saúde" Command="{Binding ShareHealthCommand}" HorizontalAlignment="Left" Margin="0,12"/><TextBlock Text="Nada é enviado ao trocar de tela. O compartilhamento é explícito e revogável; reputação não é saúde do computador." Style="{DynamicResource Caption}"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Notificações"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel Margin="0,0,0,16"><Button Content="Atualizar notificações" Command="{Binding LoadNotificationsCommand}" DockPanel.Dock="Right"/><TextBlock Text="{Binding NotificationSummary}" Style="{DynamicResource Caption}" VerticalAlignment="Center"/></DockPanel><ListBox Grid.Row="1" ItemsSource="{Binding Notifications}"><ListBox.ItemTemplate><DataTemplate><DockPanel><Button Content="Marcar como lida" DockPanel.Dock="Right" Command="{Binding DataContext.ReadNotificationCommand, RelativeSource={RelativeSource AncestorType=views:CommunityFeedView}}" CommandParameter="{Binding}" Margin="18,0,0,0"/><StackPanel><TextBlock Text="{Binding Kind, Converter={StaticResource NotificationLabel}}" FontWeight="SemiBold"/><TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd/MM HH:mm}}" Style="{DynamicResource Caption}"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem>
  </TabControl>
  <TextBlock Grid.Row="2" Text="{Binding Status}" Style="{DynamicResource Caption}" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite"/>
 </Grid>
</UserControl>
