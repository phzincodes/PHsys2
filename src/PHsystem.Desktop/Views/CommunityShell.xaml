<UserControl x:Class="PHsystem.Desktop.Views.CommunityShell" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:PHsystem.Desktop.Views">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="SessionVisibility"/></UserControl.Resources>
 <Grid>
 <Border Style="{DynamicResource Panel}" MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsOfflineUser, Converter={StaticResource SessionVisibility}}"><StackPanel><TextBlock Text="Converse com a comunidade" Style="{DynamicResource Title}"/><TextBlock Text="Entre para publicar, responder e acompanhar soluções. As análises e o histórico do computador continuam disponíveis sem conta e sem internet." Style="{DynamicResource Caption}" Margin="0,12,0,24"/><Button Content="Entrar ou criar conta" Command="{Binding OpenAccountCommand}" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Left"/></StackPanel></Border>
 <TabControl Visibility="{Binding IsAuthenticated, Converter={StaticResource SessionVisibility}}" SelectedIndex="{Binding SocialTabIndex, Mode=TwoWay}"><TabItem Header="Comunidade"><views:CommunityFeedView DataContext="{Binding Community}"/></TabItem><TabItem Header="Conta, mensagens e privacidade"><views:CommunityView/></TabItem></TabControl>
 </Grid>
</UserControl>
