<UserControl x:Class="PHsystem.Desktop.Views.CommunityView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Unloaded="ViewUnloaded" xmlns:local="clr-namespace:PHsystem.Desktop">
  <UserControl.Resources>
    <local:ReviewLabelConverter x:Key="ReviewLabel" />
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Style="{DynamicResource Notice}" Margin="0,0,0,16">
      <TextBlock Text="{Binding Community.Status}" Style="{DynamicResource Caption}" AutomationProperties.LiveSetting="Polite" />
    </Border>
    <TabControl Grid.Row="1" SelectedIndex="{Binding CommunityTabIndex, Mode=TwoWay}">
      <TabItem Header="Minha conta"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel DataContext="{Binding Community}" Margin="0,0,12,20"><Border Style="{DynamicResource Panel}"><StackPanel><TextBlock Text="{Binding Username}" Style="{DynamicResource Title}"/><TextBlock Text="Sessão autenticada. Seus diagnósticos continuam privados e locais." Style="{DynamicResource Caption}" Margin="0,12,0,20"/><Button Content="Sair da conta" Command="{Binding LogoutCommand}" HorizontalAlignment="Left"/></StackPanel></Border><Expander Header="Excluir minha conta"><StackPanel Margin="0,12,0,0"><TextBlock Text="Confirme sua senha e o consentimento. Dados públicos serão removidos ou anonimizados conforme a política de retenção; seu diagnóstico local será preservado." Style="{DynamicResource Caption}"/><CheckBox Content="Solicito a exclusão da minha conta" IsChecked="{Binding DeleteConsent}"/><TextBlock Text="Senha atual" Style="{DynamicResource FieldLabel}"/><PasswordBox x:Name="AccountPassword" PasswordChanged="AccountPasswordChanged" AutomationProperties.Name="Senha para excluir conta"/><Button Content="Excluir conta" Click="DeleteAccountClick" Style="{DynamicResource DangerButton}" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Expander></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Perguntas">
        <TabControl DataContext="{Binding Community}" IsEnabled="{Binding IsReady}">
          <TabItem Header="Explorar">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,16">
                <Button Content="Buscar perguntas" Command="{Binding SearchPostsCommand}" DockPanel.Dock="Right" Margin="12,0,0,0" />
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Pesquisar perguntas" />
              </DockPanel>
              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="0.9*" />
                  <ColumnDefinition Width="1.1*" />
                </Grid.ColumnDefinitions>
                <ListBox ItemsSource="{Binding Posts}" SelectedItem="{Binding SelectedPost}" Margin="0,0,18,0" AutomationProperties.Name="Perguntas da comunidade">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Author}" Style="{DynamicResource Caption}" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding Category}" Style="{DynamicResource Caption}" FontSize="11" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="0,0,12,10">
                    <TextBlock Text="{Binding SelectedPost.Title}" Style="{DynamicResource SectionTitle}" />
                    <TextBlock Text="{Binding SelectedPost.Body}" Foreground="{DynamicResource SecondaryBrush}" Margin="0,10,0,18" />
                    <Button Content="Carregar respostas" Command="{Binding LoadRepliesCommand}" HorizontalAlignment="Left" />
                    <ListBox ItemsSource="{Binding Replies}" SelectedItem="{Binding SelectedReply}" MaxHeight="260" Margin="0,14,0,0">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <StackPanel>
                            <DockPanel>
                              <TextBlock Text="{Binding Author}" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding ReviewState, Converter={StaticResource ReviewLabel}}" DockPanel.Dock="Right" Foreground="{DynamicResource WarningBrush}" FontSize="10" Margin="10,0,0,0" />
                            </DockPanel>
                            <TextBlock Text="{Binding Body}" Margin="0,6,0,0" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="Marcar como solução" Command="{Binding AcceptSolutionCommand}" HorizontalAlignment="Left" Margin="0,10,0,18" />
                    <TextBlock Text="Sua resposta" Style="{DynamicResource FieldLabel}" />
                    <TextBox Text="{Binding ReplyBody, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxLength="8000" AutomationProperties.Name="Texto da resposta" />
                    <Button Content="Enviar resposta" Command="{Binding ReplyCommand}" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                    <Expander Header="Denunciar esta pergunta">
                      <StackPanel Margin="0,12,0,0">
                        <TextBox Text="{Binding ReportReason, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" AutomationProperties.Name="Motivo da denúncia" />
                        <Button Content="Enviar denúncia" Command="{Binding ReportCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Grid>
          </TabItem>
          <TabItem Header="Nova pergunta">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <Border Style="{DynamicResource Panel}" Margin="0,0,12,0">
                <StackPanel>
                  <TextBlock Text="O que você precisa resolver?" Style="{DynamicResource SectionTitle}" />
                  <TextBlock Text="Não inclua senhas, seriais, caminhos pessoais ou logs brutos. Respostas começam como não verificadas." Style="{DynamicResource Caption}" Margin="0,7,0,20" />
                  <TextBlock Text="Título" Style="{DynamicResource FieldLabel}" />
                  <TextBox Text="{Binding PostTitle, UpdateSourceTrigger=PropertyChanged}" MaxLength="160" AutomationProperties.Name="Título da pergunta" />
                  <TextBlock Text="Categoria" Style="{DynamicResource FieldLabel}" Margin="0,16,0,6" />
                  <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding PostCategory}" AutomationProperties.Name="Categoria da pergunta" />
                  <TextBlock Text="Descreva o problema" Style="{DynamicResource FieldLabel}" Margin="0,16,0,6" />
                  <TextBox Text="{Binding PostBody, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180" MaxLength="8000" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Conteúdo da pergunta" />
                  <Button Content="Publicar pergunta" Command="{Binding PublishPostCommand}" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,18,0,0" />
                </StackPanel>
              </Border>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </TabItem>
      <TabItem Header="Mensagens">
        <Grid DataContext="{Binding Community}" IsEnabled="{Binding IsReady}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>
          <Border Style="{DynamicResource Panel}" Margin="0,0,18,0">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <Button Content="Atualizar" Command="{Binding LoadMessagesCommand}" DockPanel.Dock="Right" />
                <TextBlock Text="Minhas mensagens" Style="{DynamicResource SectionTitle}" />
              </DockPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Messages}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{DynamicResource Notice}" Margin="0,0,0,10">
                        <TextBlock Text="{Binding}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Border>
          <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
              <Border Style="{DynamicResource Panel}">
                <StackPanel>
                  <TextBlock Text="Nova mensagem" Style="{DynamicResource SectionTitle}" />
                  <TextBlock Text="ID do destinatário" Style="{DynamicResource FieldLabel}" Margin="0,18,0,6" />
                  <TextBox Text="{Binding RecipientId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="ID do destinatário" />
                  <TextBlock Text="Mensagem" Style="{DynamicResource FieldLabel}" Margin="0,16,0,6" />
                  <TextBox Text="{Binding MessageBody, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="2000" MinHeight="150" AutomationProperties.Name="Texto da mensagem" />
                  <WrapPanel Margin="0,16,0,0">
                    <Button Content="Enviar mensagem" Command="{Binding SendMessageCommand}" Style="{DynamicResource PrimaryButton}" Margin="0,0,10,8" />
                    <Button Content="Bloquear destinatário" Command="{Binding BlockCommand}" Style="{DynamicResource QuietButton}" Margin="0,0,0,8" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Style="{DynamicResource Panel}" Margin="0,16,0,0">
                <StackPanel>
                  <TextBlock Text="Quem pode falar comigo" FontWeight="SemiBold" />
                  <CheckBox IsChecked="{Binding AcceptMessages}" Margin="0,12,0,8">
                    <TextBlock Text="Aceito receber mensagens diretas" />
                  </CheckBox>
                  <Button Content="Salvar preferência" Command="{Binding MessagePrivacyCommand}" HorizontalAlignment="Left" />
                  <TextBlock Text="Recebimento desativado por padrão. Mensagens são armazenadas no servidor e não têm criptografia ponta a ponta." Style="{DynamicResource Caption}" Margin="0,12,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="Perfil público">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel DataContext="{Binding Community}" IsEnabled="{Binding IsReady}" Margin="0,0,12,20">
            <Border Style="{DynamicResource Panel}">
              <StackPanel>
                <DockPanel>
                  <Button Content="Preparar prévia" Command="{Binding PrepareSharingCommand}" DockPanel.Dock="Right" Margin="20,0,0,0" />
                  <StackPanel>
                    <TextBlock Text="Escolha o que os outros poderão ver" Style="{DynamicResource SectionTitle}" />
                    <TextBlock Text="Todos os campos começam privados. A prévia usa o diagnóstico local, sem nova coleta." Style="{DynamicResource Caption}" Margin="0,6,0,0" />
                  </StackPanel>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding ShareFields}" Margin="0,20,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition />
                          </Grid.ColumnDefinitions>
                          <CheckBox Content="{Binding Label}" IsChecked="{Binding Selected}" />
                          <TextBlock Grid.Column="1" Text="{Binding DisplayValue}" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel Margin="0,20,0,0">
                  <Button Content="Publicar campos selecionados" Command="{Binding PublishSharingCommand}" Style="{DynamicResource PrimaryButton}" Margin="0,0,10,8" />
                  <Button Content="Retirar compartilhamento" Command="{Binding RevokeSharingCommand}" Margin="0,0,0,8" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <TextBlock Text="Somente os valores marcados são enviados após publicar. Seriais, IP, MAC e caminhos não fazem parte desta seleção. A retirada preserva seu diagnóstico local." Style="{DynamicResource Caption}" Margin="0,14,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Resumo local">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left">
          <Border Style="{DynamicResource Panel}">
            <StackPanel>
              <TextBlock Text="Prepare um resumo para compartilhar" Style="{DynamicResource SectionTitle}" />
              <TextBlock Text="Inclui somente os nomes e estados das categorias. Não inclui detalhes de hardware, versões, erros ou caminhos. Nada é enviado automaticamente." Style="{DynamicResource Caption}" Margin="0,8,0,18" />
              <WrapPanel>
                <Button Content="Preparar resumo" Command="{Binding PrepareDraftCommand}" Margin="0,0,10,8" />
                <Button Content="Salvar arquivo JSON" Command="{Binding ExportDraftCommand}" Margin="0,0,0,8" />
              </WrapPanel>
              <TextBox Text="{Binding CommunityText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="210" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0" AutomationProperties.Name="Resumo local para compartilhamento" />
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>