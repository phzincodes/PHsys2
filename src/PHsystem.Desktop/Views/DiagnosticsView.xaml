<UserControl x:Class="PHsystem.Desktop.Views.DiagnosticsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:PHsystem.Desktop.Views">
  <TabControl>
    <TabItem Header="Resumo"><views:ResultsSummaryView/></TabItem>
    <TabItem Header="Componentes">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" MinWidth="140" MaxWidth="250" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,18,0">
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Filtrar componentes" Style="{DynamicResource FieldLabel}" />
            <TextBox Text="{Binding CategoryFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filtrar componentes por nome ou estado" />
          </StackPanel>
          <ListBox ItemsSource="{Binding FilteredCategories}" SelectedItem="{Binding SelectedCategory}" AutomationProperties.AutomationId="DiagnosticCategories">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding State}" FontSize="11" Foreground="{DynamicResource SecondaryBrush}" Margin="0,3,0,0" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
        <Border Grid.Column="1" Style="{DynamicResource Panel}">
          <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel DataContext="{Binding SelectedCategory}" Margin="0,0,8,0">
                <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="SemiBold" LineHeight="29" />
                <Border Style="{DynamicResource StateBadge}" Margin="0,10,0,18">
                  <TextBlock Text="{Binding State}" FontSize="11" />
                </Border>
                <DataGrid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" ItemsSource="{Binding Facts}" MaxHeight="490" MinRowHeight="36" Background="Transparent" AutomationProperties.Name="Informações do componente">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Informação" Binding="{Binding Name}" Width="0.9*" />
                    <DataGridTemplateColumn Header="Valor" Width="1.1*" SortMemberPath="Value">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Value}" TextWrapping="Wrap" Margin="0,8" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
                <Border Background="{DynamicResource DangerMutedBrush}" Padding="12" CornerRadius="4" Margin="0,10,0,0">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasErrors}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding Errors}" Foreground="{DynamicResource DangerBrush}" />
                </Border>
                <Expander Header="Origem e validade da informação">
                  <StackPanel Margin="20,12,0,0">
                    <TextBlock Text="{Binding Source}" Style="{DynamicResource Caption}" />
                    <TextBlock Text="{Binding ExpiresAt}" Style="{DynamicResource Caption}" Margin="0,4,0,0" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
            <TextBlock Text="Selecione um componente. Se a lista estiver vazia, execute uma análise ou altere o filtro." VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="310" Foreground="{DynamicResource SecondaryBrush}" FontSize="12">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap" />
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedCategory}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </Border>
      </Grid>
    </TabItem>
    <TabItem Header="Pontos de atenção">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
          <ItemsControl ItemsSource="{Binding Findings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{DynamicResource Panel}" Margin="0,0,12,12">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{DynamicResource SectionTitle}" />
                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource SecondaryBrush}" Margin="0,8,0,14" />
                    <TextBlock Text="EVIDÊNCIA" Style="{DynamicResource Eyebrow}" />
                    <TextBlock Text="{Binding Evidence}" Margin="0,4,0,14" />
                    <TextBlock Text="PRÓXIMO PASSO" Style="{DynamicResource Eyebrow}" />
                    <TextBlock Text="{Binding PossibleAction}" Margin="0,4,0,0" />
                    <Expander Header="Impacto e cuidados">
                      <StackPanel Margin="20,10,0,0">
                        <TextBlock Text="{Binding Impact}" />
                        <TextBlock Text="{Binding Risk}" Foreground="{DynamicResource WarningBrush}" Margin="0,8,0,0" />
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border VerticalAlignment="Top" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="20">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Findings.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel>
              <TextBlock Text="Nenhum ponto de atenção registrado" Style="{DynamicResource SectionTitle}" />
              <TextBlock Text="As regras atuais ainda têm escopo limitado. Ausência de alerta não comprova que o computador está livre de problemas." Style="{DynamicResource Caption}" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>
    </TabItem>
  <TabItem Header="Rede / testes"><ScrollViewer><StackPanel DataContext="{Binding NetworkLab}" MaxWidth="720" HorizontalAlignment="Left"><TextBlock Text="Network Lab" Style="{DynamicResource Title}"/><TextBlock Text="Destino (hostname ou IP)" Margin="0,20,0,8"/><TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" MinWidth="280"/><WrapPanel Margin="0,16"><Button Content="Testar DNS e ping" Command="{Binding StartCommand}" Style="{DynamicResource PrimaryButton}"/><Button Content="Interromper" Command="{Binding CancelCommand}" Margin="10,0"/></WrapPanel><TextBlock Text="{Binding Result}" AutomationProperties.LiveSetting="Polite"/></StackPanel></ScrollViewer></TabItem><TabItem Header="Ferramentas oficiais"><StackPanel><TextBlock Text="Próximos passos seguros" Style="{DynamicResource Title}"/><TextBlock Text="Estas ações abrem ferramentas do Windows. O PHsystem não declara reparo ou verificação de malware concluídos." Margin="0,16"/><WrapPanel><Button Content="Segurança do Windows" Command="{Binding OpenWindowsSecurityCommand}"/><Button Content="Windows Update" Command="{Binding OpenWindowsUpdateCommand}" Margin="12,0"/><Button Content="Aplicativos de inicialização" Command="{Binding OpenStartupSettingsCommand}"/></WrapPanel></StackPanel></TabItem><TabItem Header="Avaliação de saúde"><ScrollViewer><StackPanel><TextBlock Text="{Binding HealthLabel}" Style="{DynamicResource Title}"/><TextBlock Text="{Binding HealthCoverage}" Margin="0,12"/><TextBlock Text="{Binding HealthExplanation}" Style="{DynamicResource Caption}"/><ItemsControl ItemsSource="{Binding HealthDimensions}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{DynamicResource Panel}" Margin="0,16,0,0"><StackPanel><DockPanel><TextBlock Text="{Binding Display}" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding Name}" Style="{DynamicResource SectionTitle}"/></DockPanel><TextBlock Text="{Binding Status}" Margin="0,8"/><TextBlock Text="{Binding Evidence}"/><TextBlock Text="{Binding Source}" Style="{DynamicResource Caption}" Margin="0,8,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="Exportar relatório reduzido" Command="{Binding ExportSafeReportCommand}" HorizontalAlignment="Left" Margin="0,20"/></StackPanel></ScrollViewer></TabItem><TabItem Header="Investigar travamentos"><ScrollViewer><StackPanel><TextBlock Text="Crash Investigator" Style="{DynamicResource Title}"/><TextBlock Text="{Binding StabilitySummary}" Margin="0,16,0,8"/><TextBlock Text="{Binding StabilityScope}" Style="{DynamicResource Caption}"/><ItemsControl ItemsSource="{Binding StabilityEvents}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{DynamicResource Notice}" Margin="0,16,0,0"><StackPanel><TextBlock Text="{Binding Kind}" Style="{DynamicResource SectionTitle}"/><TextBlock Text="{Binding At, StringFormat={}{0:dd/MM/yyyy HH:mm:ss zzz}}" Foreground="{DynamicResource AccentBrush}" Margin="0,8"/><TextBlock Text="{Binding Provider}"/><TextBlock Text="{Binding EventId, StringFormat={}Evento {0}}"/><TextBlock Text="{Binding Context}" Style="{DynamicResource Caption}" Margin="0,8,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></TabItem></TabControl>
</UserControl>