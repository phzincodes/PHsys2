<UserControl x:Class="PHsystem.Desktop.Views.DriversView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Style="{DynamicResource Notice}" Margin="0,0,0,18">
      <DockPanel>
        <Button Content="Atualizar inventário" Command="{Binding ScanCommand}" DockPanel.Dock="Right" Margin="20,0,0,0" />
        <StackPanel>
          <TextBlock Text="Vídeo e rede" Style="{DynamicResource SectionTitle}" />
          <TextBlock Text="{Binding DriverCountLabel}" Style="{DynamicResource Caption}" Margin="0,4,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Grid.Row="1" Style="{DynamicResource Panel}" Padding="0">
      <Grid>
        <DataGrid ItemsSource="{Binding Drivers}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Dispositivo registrado" Binding="{Binding Name}" Width="*" />
            <DataGridTextColumn Header="Fornecedor e versão" Binding="{Binding VersionAndProvider}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="Execute um diagnóstico para carregar o inventário de drivers." VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryBrush}" FontSize="12">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="TextWrapping" Value="Wrap" />
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Drivers.Count}" Value="0">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
    </Border>
    <Border Grid.Row="2" Style="{DynamicResource Notice}" Margin="0,16,0,0">
      <TextBlock Text="Consulta somente. A versão instalada não comprova que o driver é o mais recente ou compatível. Busca oficial, verificação de pacote e instalação ainda não estão disponíveis." Style="{DynamicResource Caption}" />
    </Border>
  </Grid>
</UserControl>