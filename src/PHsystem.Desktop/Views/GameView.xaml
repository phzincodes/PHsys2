<UserControl x:Class="PHsystem.Desktop.Views.GameView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="820" HorizontalAlignment="Left"><Border Style="{DynamicResource Panel}"><StackPanel><TextBlock Text="Perfil temporário de prioridade" Style="{DynamicResource SectionTitle}"/><TextBlock Text="Escolha o processo do jogo. O perfil usa prioridade AboveNormal por até 30 minutos e preserva a prioridade anterior para restauração." Style="{DynamicResource Caption}" Margin="0,8,0,24"/><DockPanel Margin="0,0,0,8"><Button Content="Atualizar lista" Command="{Binding RefreshProcessesCommand}" VerticalAlignment="Bottom" DockPanel.Dock="Right" Margin="12,0,0,0"/><StackPanel><TextBlock Text="Processo do jogo" Style="{DynamicResource FieldLabel}"/><ComboBox ItemsSource="{Binding GameProcesses}" SelectedItem="{Binding SelectedProcess}" DisplayMemberPath="Name" MinWidth="290" AutomationProperties.Name="Processo do jogo"/></StackPanel></DockPanel><WrapPanel Margin="0,18,0,0"><Button Content="Aplicar perfil temporário" Command="{Binding StartGameCommand}" Style="{DynamicResource PrimaryButton}" Margin="0,0,10,10"/><Button Content="Restaurar prioridade" Command="{Binding StopGameCommand}" Margin="0,0,0,10"/></WrapPanel><Border Style="{DynamicResource Notice}" Margin="0,10,0,0"><TextBlock Text="{Binding GameStatus}"/></Border></StackPanel></Border><Border Style="{DynamicResource Notice}" Margin="0,18,0,0"><StackPanel><TextBlock Text="O que este perfil faz" FontWeight="SemiBold"/><TextBlock Text="Altera somente a prioridade do processo escolhido. Não muda afinidade, serviços, Defender, firewall, paginação ou Windows Update. A medição comparativa de FPS ainda não está disponível." Style="{DynamicResource Caption}" Margin="0,6,0,0"/></StackPanel></Border><Expander Header="Restauração e limitações"><TextBlock Text="A prioridade é restaurada ao encerrar o perfil ou fechar normalmente o PHsystem. Se o aplicativo for encerrado à força, pode ser necessário restaurar a prioridade no Gerenciador de Tarefas. Não há promessa de aumento de FPS." Style="{DynamicResource Caption}" Margin="20,10,0,0"/></Expander></StackPanel></ScrollViewer>
</UserControl>