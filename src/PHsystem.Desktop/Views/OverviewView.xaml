<UserControl x:Class="PHsystem.Desktop.Views.OverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:components="clr-namespace:PHsystem.Desktop.Components">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="0,8"><DockPanel Margin="0,0,0,24"><TextBlock Text="RED ECLIPSE / CENTRAL DO COMPUTADOR" Style="{DynamicResource Eyebrow}"/></DockPanel><Border Style="{DynamicResource Panel}" Margin="0,0,0,20"><StackPanel><DockPanel><StackPanel DockPanel.Dock="Right"><Button Content="ANALISAR" Command="{Binding ScanCommand}" Style="{DynamicResource PrimaryButton}" Width="180" Height="44" FontSize="14" AutomationProperties.AutomationId="HomeAnalyze"/><Button Content="Interromper" Command="{Binding CancelCommand}" Style="{DynamicResource QuietButton}" Visibility="{Binding IsScanning, Converter={StaticResource BoolVisibility}}"/></StackPanel><Viewbox Width="72" Height="72" DockPanel.Dock="Left" Margin="0,0,20,0"><Grid Width="140" Height="140" Margin="0,0,0,12">
     <Path x:Name="ScanArc" Data="M70,4 A66,66 0 0 1 136,70" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Opacity="0.8"><Path.RenderTransform><RotateTransform x:Name="ScanRotation" CenterX="70" CenterY="70"/></Path.RenderTransform></Path>
     <Ellipse Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" Margin="4"/>
     <Ellipse Stroke="{DynamicResource AccentMutedBrush}" StrokeThickness="12" Margin="27"/>
     <Ellipse Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" Margin="34" Opacity="0.5"/>
     <Ellipse Fill="{DynamicResource PanelBrush}" Margin="48"/>
     <components:IconControl Data="M12,3 L20,8 V16 L12,21 4,16 V8 Z M8,10 H16 M8,14 H16 M12,7 V17" Width="56" Height="56" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1"/>
    </Grid></Viewbox><StackPanel VerticalAlignment="Center"><TextBlock Text="Analisar computador" Style="{DynamicResource SectionTitle}"/><TextBlock Text="{Binding ScanState}" Style="{DynamicResource Caption}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel></DockPanel><StackPanel Visibility="{Binding IsScanning, Converter={StaticResource BoolVisibility}}" Margin="0,16,0,0"><ProgressBar Value="{Binding CompletedCollectors, Mode=OneWay}" Maximum="{Binding TotalCollectors, Mode=OneWay}" Height="4"/><TextBlock Text="{Binding ScanProgressLabel}" Style="{DynamicResource Caption}" Margin="0,8"/><ItemsControl ItemsSource="{Binding ScanCollectors}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><TextBlock Text="{Binding State}" DockPanel.Dock="Right" Foreground="{DynamicResource SecondaryBrush}"/><TextBlock Text="{Binding Name}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></StackPanel></Border><components:ResponsivePanel Margin="0,0,0,16"><Border Style="{DynamicResource Panel}"><StackPanel><TextBlock Text="Última análise" Style="{DynamicResource SectionTitle}"/><TextBlock Text="{Binding LastScanLabel}" FontSize="24" Margin="0,16,0,8"/><TextBlock Text="{Binding HealthLabel}" FontSize="19" Margin="0,0,0,8"/><TextBlock Text="{Binding HealthCoverage}" Style="{DynamicResource Caption}"/><TextBlock Text="Saúde não é só uma nota. Consulte a cobertura e as evidências antes de agir." Style="{DynamicResource Caption}" Margin="0,12,0,0"/></StackPanel></Border><Border Style="{DynamicResource Panel}"><StackPanel><TextBlock Text="O que merece atenção" Style="{DynamicResource SectionTitle}"/><TextBlock Text="{Binding FindingsSummary}" FontSize="22" Margin="0,16,0,8"/><Button Content="Entender os resultados" Command="{Binding OpenDiagnosticsCommand}" HorizontalAlignment="Left"/></StackPanel></Border></components:ResponsivePanel><ItemsControl ItemsSource="{Binding DashboardWidgets}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><components:ResponsivePanel Margin="0,0,0,16"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Visibility" Value="{Binding Enabled, Converter={StaticResource BoolVisibility}}"/></Style></ItemsControl.ItemContainerStyle><ItemsControl.ItemTemplate><DataTemplate><Border Style="{DynamicResource Notice}"><StackPanel><TextBlock Text="{Binding Title}" Style="{DynamicResource Eyebrow}"/><TextBlock Text="{Binding Value}" FontSize="20" Margin="0,8"/><TextBlock Text="{Binding Detail}" Style="{DynamicResource Caption}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><WrapPanel Margin="0,20"><Button Content="Armazenamento" Command="{Binding OpenStorageCommand}"/><Button Content="Limpeza segura" Command="{Binding OpenCleanupCommand}" Margin="10,0"/><Button Content="Histórico" Command="{Binding OpenHistoryCommand}"/></WrapPanel></StackPanel>
 </ScrollViewer>
</UserControl>
