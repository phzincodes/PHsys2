<UserControl x:Class="PHsystem.Desktop.Views.PrivacyView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,20" MaxWidth="940" HorizontalAlignment="Left"><Border Style="{DynamicResource Panel}"><StackPanel><TextBlock Text="O diagnóstico permanece no seu computador" Style="{DynamicResource SectionTitle}"/><TextBlock Text="A análise consulta o Windows localmente. Não envia o inventário para a comunidade nem exige uma conta para funcionar." Foreground="{DynamicResource SecondaryBrush}" Margin="0,8,0,20"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="DADOS LOCAIS" Style="{DynamicResource Eyebrow}"/><TextBlock Text="Análises, versões e informações de componentes ficam no histórico deste perfil Windows." Margin="0,8,0,12"/><Button Content="Abrir histórico" Command="{Binding OpenHistoryCommand}" HorizontalAlignment="Left"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="DADOS COMPARTILHADOS" Style="{DynamicResource Eyebrow}"/><TextBlock Text="Somente os campos que você selecionar e publicar no perfil da comunidade." Margin="0,8,0,12"/><Button Content="Revisar compartilhamento" Command="{Binding OpenSharingCommand}" HorizontalAlignment="Left"/></StackPanel></Grid></StackPanel></Border><Border Style="{DynamicResource Panel}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Exportações e arquivos pessoais" Style="{DynamicResource SectionTitle}"/><TextBlock Text="Exportar diagnóstico cria um arquivo privado no local escolhido. Revise-o antes de compartilhar. Nomes de arquivos da análise de pasta ficam na memória e não entram no snapshot ou no perfil público." Style="{DynamicResource Caption}" Margin="0,8,0,16"/><TextBlock Text="A limpeza não examina automaticamente Documentos, Downloads, navegadores ou pastas do Windows. A análise de pasta exige uma escolha e autorização separadas." Style="{DynamicResource Caption}"/></StackPanel></Border><Border Style="{DynamicResource Notice}" Margin="0,18,0,0"><TextBlock Text="O aplicativo não solicita elevação. Mensagens da comunidade não têm criptografia ponta a ponta. A proteção do banco local depende das permissões do seu perfil Windows." Style="{DynamicResource Caption}"/></Border><Expander Header="Local dos dados e limitações"><TextBlock Text="Histórico: %LOCALAPPDATA%\PHsystemNext\snapshots.db. Seriais, IP, MAC e nome do computador não são intencionalmente coletados pelos adaptadores atuais. Recursos de segurança, privacidade e conformidade continuam em desenvolvimento; consulte a documentação do projeto." Style="{DynamicResource Caption}" Margin="20,10,0,0"/></Expander></StackPanel></ScrollViewer>
</UserControl>