<UserControl x:Class="PHsystem.Desktop.Views.RecommendationsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,12,20">
      <Border Style="{DynamicResource Notice}" Margin="0,0,0,18">
        <TextBlock Text="Orientações baseadas na última análise. Revise a evidência e os cuidados antes de agir. Nenhuma configuração é alterada automaticamente." Style="{DynamicResource Caption}" />
      </Border>
      <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Style="{DynamicResource Panel}" Margin="0,0,0,18" Visibility="{Binding HasExpiredEvidence, Converter={StaticResource BoolVisibility}}">
        <StackPanel>
          <DockPanel>
            <Button Content="Atualizar análise" Command="{Binding ScanCommand}" Style="{DynamicResource PrimaryButton}" DockPanel.Dock="Right" Margin="20,0,0,0" />
            <StackPanel>
              <TextBlock Text="Atualize as evidências antes de decidir" Style="{DynamicResource SectionTitle}" />
              <TextBlock Text="{Binding ExpiredEvidenceLabel}" Style="{DynamicResource Caption}" Margin="0,8,0,0" />
            </StackPanel>
          </DockPanel>
          <Expander Header="Categorias que precisam de atualização">
            <ItemsControl ItemsSource="{Binding RefreshRecommendations}" Margin="18,10,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Title}" Style="{DynamicResource Caption}" Margin="0,0,0,5" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>
        </StackPanel>
      </Border>
      <ItemsControl ItemsSource="{Binding CurrentRecommendations}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{DynamicResource Panel}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{DynamicResource SectionTitle}" />
                <TextBlock Text="{Binding Detail}" Margin="0,10,0,16" Foreground="{DynamicResource SecondaryBrush}" />
                <Border Style="{DynamicResource Notice}">
                  <StackPanel>
                    <TextBlock Text="POR QUE ESTA ORIENTAÇÃO" Style="{DynamicResource Eyebrow}" />
                    <TextBlock Text="{Binding Evidence}" Margin="0,5,0,0" />
                  </StackPanel>
                </Border>
                <Expander Header="Cuidados e referência técnica">
                  <StackPanel Margin="20,10,0,0">
                    <TextBlock Text="{Binding Risk}" Foreground="{DynamicResource WarningBrush}" />
                    <TextBlock Text="{Binding Source}" Style="{DynamicResource Caption}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding ReviewedOn, StringFormat=Referência revisada em {0}}" Style="{DynamicResource Caption}" Margin="0,5,0,0" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Style="{DynamicResource Notice}">
        <TextBlock Text="Sem score de saúde ou promessa de ganho de desempenho. O PH CORE atual usa regras determinísticas, com escopo limitado a evidências disponíveis." Style="{DynamicResource Caption}" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>