<UserControl x:Class="PHsystem.Desktop.Views.ResultsSummaryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:components="clr-namespace:PHsystem.Desktop.Components">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,20">
  <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Style="{DynamicResource Panel}" Margin="0,0,12,0"><StackPanel><TextBlock Text="PROCESSADOR" Style="{DynamicResource Eyebrow}"/><TextBlock Text="{Binding CpuModel}" FontSize="16" FontWeight="SemiBold" LineHeight="23" Margin="0,12,0,6" MinHeight="46"/><TextBlock Text="{Binding CpuDetail}" Style="{DynamicResource Caption}"/></StackPanel></Border>
   <Border Grid.Column="1" Style="{DynamicResource Panel}" Margin="0,0,12,0"><StackPanel><TextBlock Text="MEMÓRIA" Style="{DynamicResource Eyebrow}"/><TextBlock Text="{Binding MemoryTotal}" FontSize="28" FontWeight="SemiBold" Margin="0,12,0,8" LineHeight="34"/><TextBlock Text="{Binding MemoryDetail}" Style="{DynamicResource Caption}"/><ProgressBar Value="{Binding MemoryUsedPercent, Mode=OneWay}" Maximum="100" Margin="0,12,0,0" ToolTip="{Binding MemoryUsageLabel}"/></StackPanel></Border>
   <Border Grid.Column="2" Style="{DynamicResource Panel}"><StackPanel><TextBlock Text="ARMAZENAMENTO DISPONÍVEL" Style="{DynamicResource Eyebrow}"/><TextBlock Text="{Binding StorageAvailable}" FontSize="28" FontWeight="SemiBold" Margin="0,12,0,8" LineHeight="34"/><TextBlock Text="{Binding StorageDetail}" Style="{DynamicResource Caption}"/><Button Content="Ver armazenamento →" Style="{DynamicResource QuietButton}" Command="{Binding OpenStorageCommand}" HorizontalAlignment="Left" Padding="0,6" MinHeight="24" Margin="0,4,0,0"/></StackPanel></Border>
  </Grid>
  <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{DynamicResource Panel}" Margin="0,0,20,0"><StackPanel><DockPanel Margin="0,0,0,14"><TextBlock Text="Este computador" Style="{DynamicResource SectionTitle}"/><Border Style="{DynamicResource StateBadge}" DockPanel.Dock="Right" HorizontalAlignment="Right"><TextBlock Text="LOCAL" FontSize="10" Foreground="{DynamicResource SecondaryBrush}"/></Border></DockPanel>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Sistema" Style="{DynamicResource Caption}"/><TextBlock Grid.Column="1" Text="{Binding OperatingSystem}"/></Grid>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Arquitetura" Style="{DynamicResource Caption}"/><TextBlock Grid.Column="1" Text="{Binding Architecture}"/></Grid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Última análise" Style="{DynamicResource Caption}"/><TextBlock Grid.Column="1" Text="{Binding LastScanLabel}"/></Grid>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0"><TextBlock Text="{Binding CollectionSummary}" Style="{DynamicResource Caption}"/></Border>
   </StackPanel></Border>
   <Border Grid.Column="1" Style="{DynamicResource Panel}"><StackPanel><TextBlock Text="O que você quer fazer?" Style="{DynamicResource SectionTitle}" Margin="0,0,0,12"/>
    <Button Command="{Binding OpenDiagnosticsCommand}" Style="{DynamicResource ActionRow}"><DockPanel><TextBlock Text="Examinar o diagnóstico"/><components:IconControl Data="M9,5 L16,12 9,19" DockPanel.Dock="Right" Width="20" Height="20" Stroke="{DynamicResource SecondaryBrush}"/></DockPanel></Button>
    <Button Command="{Binding OpenCleanupCommand}" Style="{DynamicResource ActionRow}"><DockPanel><TextBlock Text="Revisar temporários"/><components:IconControl Data="M9,5 L16,12 9,19" DockPanel.Dock="Right" Width="20" Height="20" Stroke="{DynamicResource SecondaryBrush}"/></DockPanel></Button>
    <Button Command="{Binding OpenRecommendationsCommand}" Style="{DynamicResource ActionRow}" Margin="0"><DockPanel><TextBlock Text="Consultar o PH CORE"/><components:IconControl Data="M9,5 L16,12 9,19" DockPanel.Dock="Right" Width="20" Height="20" Stroke="{DynamicResource SecondaryBrush}"/></DockPanel></Button>
   </StackPanel></Border>
  </Grid>
  <Border Style="{DynamicResource Panel}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="20,16"><Button Content="Abrir detalhes" Command="{Binding OpenDiagnosticsCommand}" Style="{DynamicResource QuietButton}" DockPanel.Dock="Right"/><StackPanel><TextBlock Text="Componentes analisados" Style="{DynamicResource SectionTitle}"/><TextBlock Text="{Binding FindingsSummary}" Style="{DynamicResource Caption}" Margin="0,4,0,0"/></StackPanel></DockPanel>
   <Grid Grid.Row="1"><DataGrid ItemsSource="{Binding Categories}" MaxHeight="255" AutomationProperties.Name="Resumo dos componentes"><DataGrid.Columns><DataGridTextColumn Header="Componente" Binding="{Binding Name}" Width="*"/><DataGridTemplateColumn Header="Estado" Width="125" SortMemberPath="State"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{DynamicResource StateBadge}"><TextBlock Text="{Binding State}" FontSize="11"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Informações" Binding="{Binding Detail}" Width="*"/></DataGrid.Columns></DataGrid>
    <Border Padding="30" Background="{DynamicResource PanelBrush}"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Categories.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel HorizontalAlignment="Center"><TextBlock Text="Comece pela primeira análise" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Leia os componentes do computador e salve um diagnóstico local." Style="{DynamicResource Caption}" Margin="0,6,0,16"/><Button Content="Analisar computador" Style="{DynamicResource PrimaryButton}" Command="{Binding ScanCommand}" HorizontalAlignment="Center"/></StackPanel></Border>
   </Grid>
   <Border Grid.Row="2" Padding="20,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"><TextBlock Text="Leituras parciais indicam o escopo da coleta. Uma análise não é um atestado de saúde e não gera uma nota sem evidências suficientes." Style="{DynamicResource Caption}"/></Border>
  </Grid></Border>
 </StackPanel></ScrollViewer>
</UserControl>