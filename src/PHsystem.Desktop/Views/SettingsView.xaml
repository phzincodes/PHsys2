<UserControl x:Class="PHsystem.Desktop.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="720" HorizontalAlignment="Left" DataContext="{Binding Preferences}">
  <Border Style="{DynamicResource Panel}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Aparência e personalização" Style="{DynamicResource SectionTitle}"/><TextBlock Text="Tema" Style="{DynamicResource FieldLabel}" Margin="0,16,0,0"/><ComboBox ItemsSource="{Binding ThemeNames}" SelectedItem="{Binding ThemeName}" MinWidth="260" HorizontalAlignment="Left"/><TextBlock Text="Escala de texto" Margin="0,16,0,0"/><Slider Minimum="0.9" Maximum="1.5" Value="{Binding FontScale}"/><TextBlock Text="Arredondamento"/><Slider Minimum="0" Maximum="24" Value="{Binding CornerRadius}"/><TextBlock Text="Nome do tema personalizado" Style="{DynamicResource FieldLabel}" Margin="0,16,0,0"/><TextBox Text="{Binding CustomName}"/><TextBlock Text="Cor principal (#RRGGBB)" Style="{DynamicResource FieldLabel}" Margin="0,12,0,0"/><TextBox Text="{Binding CustomAccent}"/><Expander Header="Editor de cores e contraste"><StackPanel><TextBlock Text="Fundo"/><TextBox Text="{Binding CustomBackground}"/><TextBlock Text="Superfície principal"/><TextBox Text="{Binding CustomSurface}"/><TextBlock Text="Superfície elevada"/><TextBox Text="{Binding CustomElevated}"/><TextBlock Text="Bordas"/><TextBox Text="{Binding CustomBorder}"/><TextBlock Text="Destaque secundário"/><TextBox Text="{Binding CustomSecondaryAccent}"/><TextBlock Text="Texto principal"/><TextBox Text="{Binding CustomTextColor}"/><TextBlock Text="Texto secundário"/><TextBox Text="{Binding CustomSecondaryText}"/></StackPanel></Expander><TextBlock Text="Largura da sidebar"/><Slider Minimum="180" Maximum="320" Value="{Binding SidebarSize}"/><TextBlock Text="Densidade (Compact = compacta)"/><ComboBox ItemsSource="{Binding Densities}" SelectedItem="{Binding Density}"/><WrapPanel Margin="0,14,0,0"><Button Content="Salvar como tema" Command="{Binding ApplyCustomThemeCommand}"/><Button Content="Importar" Command="{Binding ImportThemeCommand}" Margin="8,0"/><Button Content="Exportar" Command="{Binding ExportThemeCommand}"/><Button Content="Restaurar Red Eclipse" Command="{Binding RestoreThemeCommand}" Margin="8,0"/><Button Content="Remover da biblioteca" Command="{Binding RemoveThemeCommand}"/></WrapPanel></StackPanel></Border><Border Style="{DynamicResource Panel}"><StackPanel><TextBlock Text="Aparência e movimento" Style="{DynamicResource SectionTitle}" Margin="0,0,0,14"/><CheckBox Content="Animações e transições" IsChecked="{Binding AnimationsEnabled}"/><TextBlock Text="A preferência de redução de movimento do Windows tem prioridade." Style="{DynamicResource Caption}"/></StackPanel></Border>
  <Border Style="{DynamicResource Panel}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Sons" Style="{DynamicResource SectionTitle}" Margin="0,0,0,14"/><CheckBox Content="Ativar sons" IsChecked="{Binding SoundEnabled}"/><CheckBox Content="Sons de interface" IsChecked="{Binding InterfaceSounds}"/><CheckBox Content="Modo silencioso" IsChecked="{Binding SilentMode}"/><TextBlock Text="Volume geral" Style="{DynamicResource FieldLabel}" Margin="0,14,0,6"/><Slider Minimum="0" Maximum="1" Value="{Binding Volume}" MaxWidth="360" HorizontalAlignment="Left" AutomationProperties.Name="Volume geral"/><TextBlock Text="Volume de notificações" Style="{DynamicResource FieldLabel}" Margin="0,14,0,6"/><Slider Minimum="0" Maximum="1" Value="{Binding NotificationVolume}" MaxWidth="360" HorizontalAlignment="Left" AutomationProperties.Name="Volume das notificações"/></StackPanel></Border>
  <Border Style="{DynamicResource Panel}" Margin="0,18,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"><StackPanel><TextBlock Text="Sobre esta instalação" Style="{DynamicResource SectionTitle}"/><TextBlock Text="{Binding ApplicationVersion}" Margin="0,12,0,0"/><TextBlock Text="{Binding DesktopBuildId, StringFormat={}Build efetivo: {0}}"/><TextBlock Text="{Binding SourceCommit, StringFormat={}Commit de origem: {0}}"/><TextBlock Text="{Binding ContractVersion}"/><TextBlock Text="{Binding Community.ConnectionSummary}" Style="{DynamicResource Caption}" Margin="0,12,0,0"/><TextBlock Text="{Binding Community.ApiVersionSummary}" Style="{DynamicResource Caption}"/><TextBlock Text="{Binding Community.MigrationSummary, StringFormat={}Migrações: {0}}" Style="{DynamicResource Caption}"/></StackPanel></Border>
  <Border Style="{DynamicResource Panel}" Margin="0,18,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"><StackPanel><TextBlock Text="Widgets do início" Style="{DynamicResource SectionTitle}"/><TextBlock Text="Avaliação de saúde e alertas prioritários permanecem visíveis." Style="{DynamicResource Caption}" Margin="0,8"/><ItemsControl ItemsSource="{Binding DashboardWidgets}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,8"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Subir" Command="{Binding DataContext.MoveWidgetUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Code}"/><Button Content="Descer" Command="{Binding DataContext.MoveWidgetDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Code}" Margin="8,0,0,0"/></StackPanel><CheckBox Content="{Binding Title}" IsChecked="{Binding Enabled}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><TextBlock Text="{Binding Status}" Style="{DynamicResource Caption}" Margin="0,16,0,0" AutomationProperties.LiveSetting="Polite"/>
 </StackPanel></ScrollViewer>
</UserControl>
