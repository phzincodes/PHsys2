<UserControl x:Class="PHsystem.Desktop.Views.StorageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PHsystem.Desktop">
  <UserControl.Resources>
    <local:ByteSizeConverter x:Key="BytesLabel" />
  </UserControl.Resources>
  <TabControl>
    <TabItem Header="Volumes">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,12,0">
          <TextBlock Text="Espaço dos volumes locais" Style="{DynamicResource SectionTitle}" />
          <TextBlock Text="Informações da última análise. Abrir esta aba não executa outra varredura." Style="{DynamicResource Caption}" Margin="0,6,0,20" />
          <ItemsControl ItemsSource="{Binding Volumes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{DynamicResource Panel}" Margin="0,0,0,14">
                  <StackPanel>
                    <DockPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Capacity}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource SecondaryBrush}" />
                    </DockPanel>
                    <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Margin="0,16,0,10" />
                    <TextBlock Text="{Binding Available}" Style="{DynamicResource Caption}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding StorageDetail}" Style="{DynamicResource Caption}" />
          <Button Content="Atualizar diagnóstico" Command="{Binding ScanCommand}" HorizontalAlignment="Left" Margin="0,18,0,0" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Analisar uma pasta">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{DynamicResource Panel}" Margin="0,0,0,18">
          <StackPanel>
            <DockPanel>
              <Button Content="Escolher pasta…" Command="{Binding SelectStorageDirectoryCommand}" DockPanel.Dock="Right" Margin="16,0,0,0" />
              <StackPanel>
                <TextBlock Text="{Binding StorageSelectionHint}" Style="{DynamicResource SectionTitle}" />
                <TextBlock Text="{Binding StorageDirectory}" Style="{DynamicResource Caption}" Margin="0,5,0,0" />
              </StackPanel>
            </DockPanel>
            <CheckBox IsChecked="{Binding StorageConsent}" Margin="0,18,0,5">
              <TextBlock Text="Permito examinar nomes e tamanhos dos arquivos desta pasta." />
            </CheckBox>
            <CheckBox IsChecked="{Binding CompareHashes}">
              <TextBlock Text="Comparar duplicados por conteúdo (SHA-256). Pode levar mais tempo." />
            </CheckBox>
            <Button Content="Analisar pasta" Style="{DynamicResource PrimaryButton}" Command="{Binding AnalyzeStorageCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" />
          </StackPanel>
        </Border>
        <TabControl Grid.Row="1">
          <TabItem Header="Maiores arquivos">
            <Border Style="{DynamicResource Panel}" Padding="0">
              <DataGrid ItemsSource="{Binding StorageFiles}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Caminho do arquivo · privado" Binding="{Binding Path}" Width="*" />
                  <DataGridTextColumn Header="Tamanho" Binding="{Binding Bytes, Converter={StaticResource BytesLabel}}" Width="150" />
                </DataGrid.Columns>
              </DataGrid>
            </Border>
          </TabItem>
          <TabItem Header="Duplicados">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding DuplicateFiles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{DynamicResource Panel}" Margin="0,0,0,10">
                      <TextBlock Text="{Binding}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </TabItem>
        </TabControl>
        <Expander Grid.Row="2" Header="Limites e privacidade desta análise">
          <TextBlock Text="Até 20.000 arquivos, 5.000 diretórios e 60 segundos. Para hashes: até 256 MiB por arquivo e 1 GiB no total. Links e itens inacessíveis são ignorados. O resultado pode ser parcial. Os caminhos ficam somente na memória local. Nenhum arquivo é removido." Style="{DynamicResource Caption}" Margin="20,10,0,0" />
        </Expander>
      </Grid>
    </TabItem>
  </TabControl>
</UserControl>